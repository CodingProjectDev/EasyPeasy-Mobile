# EasyPeasy-Mobile
# Copy to a local .env file and fill in ONLY the public Supabase values.
# Never put the service_role key in a mobile application.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
EXPO_PUBLIC_STORE_API_URL=https://www.easypeasyez.com
